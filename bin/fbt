#!/usr/bin/env bash
# fbt - build Android and Rust projects on GitHub-hosted runners.
#
# Source is packaged into a secret gist, dispatched to the build tool repo,
# and the output lands in a local downloads directory. The gist is deleted
# after the build regardless of outcome, so nothing accumulates.
#
# Usage:
#   fbt build <project-dir> [options]
#   fbt keygen [--force]
#   fbt key
#
# Config (optional):
#   ~/.config/fbt/config
#     TOOL_REPO=<owner>/<repo>
#     DOWNLOAD_DIR=<path>
#
# Release signing (optional):
#   The key itself is stored once as Actions secrets on the tool repo, so a
#   signed build only sends signed=true. Locally, 'fbt keygen' records enough
#   to push the key again and to print its fingerprint.
#   ~/.config/fbt/signing.env
#     RELEASE_KEYSTORE_PATH=<path to .p12 or .jks>
#     RELEASE_KEYSTORE_PASSWORD=<keystore password>
#     RELEASE_KEY_ALIAS=<alias>
#     RELEASE_KEY_PASSWORD=<key password>
#
# Overrides without a config file:
#   FBT_TOOL_REPO=<owner>/<repo> FBT_DOWNLOAD_DIR=<path> fbt build <dir>
#   FBT_KEYSTORE=... FBT_KEYSTORE_PASSWORD=... FBT_KEY_ALIAS=...
#   FBT_KEY_PASSWORD=... fbt key push

set -euo pipefail

DEFAULT_TOOL_REPO="${FBT_TOOL_REPO:-}"
DOWNLOAD_DIR="${FBT_DOWNLOAD_DIR:-$HOME/Downloads}"

die() { printf 'fbt: %s\n' "$1" >&2; exit 1; }
info() { printf '  %s\n' "$1" >&2; }

load_config() {
  local cfg="${FBT_CONFIG:-$HOME/.config/fbt/config}"
  TOOL_REPO="${TOOL_REPO:-$DEFAULT_TOOL_REPO}"
  if [ -f "$cfg" ]; then
    # shellcheck disable=SC1090
    source "$cfg"
    TOOL_REPO="${TOOL_REPO:-$DEFAULT_TOOL_REPO}"
    DOWNLOAD_DIR="${DOWNLOAD_DIR:-$HOME/Downloads}"
  fi
  }

require() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed."
}

# Everything fbt owns lives beside its config file, so FBT_CONFIG pointing
# somewhere else moves the keystore and the credentials along with it.
config_file() { printf '%s' "${FBT_CONFIG:-$HOME/.config/fbt/config}"; }
signing_env_file() { printf '%s' "${FBT_SIGNING_ENV:-$(dirname "$(config_file)")/signing.env}"; }
default_keystore() { printf '%s' "${FBT_KEYSTORE_PATH:-$(dirname "$(config_file)")/release.p12}"; }

# Parsed without eval or source: a credentials file is exactly the kind of
# thing that should never be executed. Unrecognised keys are ignored so a
# file written for a newer fbt still works here.
signing_read_env() {
  local f="$1" line k v
  [ -f "$f" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    k="${line%%=*}"
    v="${line#*=}"
    case "$k" in
      RELEASE_KEYSTORE_PATH)        s_keystore="$v" ;;
      RELEASE_KEYSTORE_PASSWORD)    s_store_pass="$v" ;;
      RELEASE_STORE_PASSWORD)       s_store_pass="$v" ;;
      RELEASE_KEY_ALIAS)            s_alias="$v" ;;
      RELEASE_KEY_PASSWORD)         s_key_pass="$v" ;;
    esac
  done < "$f"
}

# Fills KS_PATH, KS_PASS, KEY_ALIAS, KEY_PASS. Environment wins over the file,
# so a one-off push can override a single value without editing anything.
resolve_signing() {
  s_keystore="" s_store_pass="" s_alias="" s_key_pass=""
  signing_read_env "$(signing_env_file)"

  KS_PATH="${FBT_KEYSTORE:-${s_keystore:-}}"
  KS_PASS="${FBT_KEYSTORE_PASSWORD:-${s_store_pass:-}}"
  KEY_ALIAS="${FBT_KEY_ALIAS:-${s_alias:-}}"
  KEY_PASS="${FBT_KEY_PASSWORD:-${s_key_pass:-}}"
  # A keystore whose key password equals the store password is the normal case,
  # and asking for it twice is noise.
  KEY_PASS="${KEY_PASS:-$KS_PASS}"

  [ -n "$KS_PATH" ] || die "no release keystore configured. Run 'fbt keygen' first, set FBT_KEYSTORE, or add RELEASE_KEYSTORE_PATH to $(signing_env_file)."
  [ -f "$KS_PATH" ] || die "keystore not found: $KS_PATH. Run 'fbt keygen' or fix RELEASE_KEYSTORE_PATH in $(signing_env_file)."
  [ -s "$KS_PATH" ] || die "keystore is empty: $KS_PATH"
  [ -n "$KS_PASS" ]  || die "no keystore password. Set FBT_KEYSTORE_PASSWORD or RELEASE_KEYSTORE_PASSWORD."
  [ -n "$KEY_ALIAS" ] || die "no key alias. Set FBT_KEY_ALIAS or RELEASE_KEY_ALIAS."

  # A keystore anybody on the machine can read is a leaked keystore waiting to
  # happen. Warn rather than refuse, since 0400 and 0600 both appear in the wild.
  local mode
  mode="$(stat -c '%a' "$KS_PATH" 2>/dev/null || echo '')"
  # Group and other are the last two octal digits; 4 is read.
  case "${mode: -2}" in
    *4*) info "warning: keystore $KS_PATH is mode $mode, consider 'chmod 600'" ;;
  esac

  # A newline in a password would silently truncate it once it is written into
  # a gradle.properties line, so refuse instead of producing a broken build.
  local v
  for v in "$KS_PASS" "$KEY_PASS"; do
    case "$v" in
      *$'\n'*|*$'\r'*) die "keystore passwords may not contain newlines" ;;
    esac
  done
}

# The signing key is stored once, as Actions secrets on the tool repo. The
# build only ever sends signed=true; the runner reads the key from there. Naming
# matches the convention used by project-side release workflows, so one key
# serves both.
SIGNING_SECRETS=(RELEASE_KEYSTORE_B64 RELEASE_KEYSTORE_PASSWORD RELEASE_KEY_ALIAS RELEASE_KEY_PASSWORD)

# Prints the names of the signing secrets present on the tool repo.
signing_secrets_present() {
  local repo="$1"
  gh secret list --repo "$repo" 2>/dev/null | awk '{print $1}'
}

# Fail before spending a gist upload and two runner minutes on a build that
# cannot possibly sign.
require_signing_secrets() {
  local repo="$1" have want missing=""
  have="$(signing_secrets_present "$repo" || true)"
  for want in "${SIGNING_SECRETS[@]}"; do
    printf '%s\n' "$have" | grep -qxF "$want" || missing="$missing $want"
  done
  [ -z "$missing" ] || die "tool repo $repo is missing signing secret(s):$missing
Run 'fbt key push' to upload the local release key."
}

# Archive a project directory, honoring its .gitignore where possible.
package_project() {
  local dir="$1"
  local dest="$2"

  # If this is a git repo with a committed tree, archive tracked files only.
  # That naturally excludes build/, .gradle/, *.apk and anything gitignored.
  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    local dirty
    dirty="$(git -C "$dir" status --porcelain | wc -l | tr -d ' ')"
    if [ "$dirty" -gt 0 ]; then
      info "note: $dirty uncommitted change(s) will be included"
    fi
    # -C keeps paths relative to the repo root inside the tarball.
    if git -C "$dir" ls-files --error-unmatch . >/dev/null 2>&1; then
      # tar.gz, not tar: the build workflows extract with 'tar xzf' and a
      # plain tar silently fails to decompress.
      git -C "$dir" archive --format=tar.gz HEAD -o "$dest" 2>/dev/null && return 0
      info "git archive failed, falling back to tar"
    fi
  fi

  # Fallback: tar the directory, excluding the usual build noise.
  tar czf "$dest" \
    -C "$dir" \
    --exclude='./build' \
    --exclude='*/build' \
    --exclude='./.gradle' \
    --exclude='*/.gradle' \
    --exclude='./.git' \
    --exclude='*/.git' \
    --exclude='./.idea' \
    --exclude='*.apk' \
    --exclude='*.aab' \
    --exclude='local.properties' \
    .
}

usage_build() {
  cat <<'USAGE'
usage: fbt build <project-dir> [options]
       fbt keygen [--alias NAME] [--dname DN] [--validity DAYS] [--force]
       fbt key [--tool REPO]
       fbt key push [--tool REPO]

Common:
  --tool REPO        tool repo (owner/name)

Android (default):
  --variant NAME     build variant (default: debug)
  --release          release variant, signed with the tool repo's release key
  --sign             sign the selected variant with the release key
  --no-sign          release variant, left unsigned

Rust (--rust):
  --profile NAME     release | dev            (default: release)
  --target TRIPLE    rustc target triple      (default: host)
  --features LIST    comma-separated features
  --all-features     pass --all-features
  --no-default-features
  --tests            run cargo test before building
  --raw              upload bare binaries instead of a tarball

Go (--go):
  --goos NAME        GOOS, e.g. linux, darwin (default: host)
  --goarch NAME      GOARCH, e.g. amd64, arm64 (default: host)
  --tests            run go test ./... before building

Release signing, one-time setup:
  fbt keygen         create ~/.config/fbt/release.p12 and signing.env
  fbt key push       store it as a secret on the tool repo
  fbt key            show the local key and which secrets the tool repo holds

Examples:
  fbt build ./my-android-app
  fbt build ./my-android-app --release
  fbt build ./my-crate --rust --tests
  fbt build ./my-cmd --go
  fbt build ./my-cmd --go --goos windows --goarch amd64
USAGE
}

# SHA-256 of the signing certificate, which is what a release consumer checks a
# downloaded artifact against. Printed in one lowercase hex form so it can be
# pasted straight into a manifest.
key_fingerprint() {
  local ks="$1" pass="$2" alias="$3" fp=""
  if command -v keytool >/dev/null 2>&1; then
    fp="$(keytool -list -v -keystore "$ks" -storepass "$pass" -alias "$alias" 2>/dev/null \
          | awk '/SHA256:/ { l=$0; sub(/.*SHA256:[[:space:]]*/, "", l); gsub(/[:[:space:]]/, "", l); print tolower(l); exit }')"
  fi
  if [ -z "$fp" ] && command -v openssl >/dev/null 2>&1; then
    fp="$(openssl pkcs12 -in "$ks" -passin "pass:$pass" -nokeys -clcerts 2>/dev/null \
          | openssl x509 -noout -fingerprint -sha256 2>/dev/null \
          | sed 's/.*=//; s/://g' | tr 'A-Z' 'a-z')"
  fi
  printf '%s' "$fp"
}

cmd_keygen() {
  local alias="release" dname="" validity=10000 force="false"
  local env_file; env_file="$(signing_env_file)"
  local ks_path; ks_path="$(default_keystore)"

  while [ $# -gt 0 ]; do
    case "$1" in
      --alias)    alias="${2:-}"; shift 2 ;;
      --dname)    dname="${2:-}"; shift 2 ;;
      --validity) validity="${2:-}"; shift 2 ;;
      --force)    force="true"; shift ;;
      -h|--help)  usage_build; exit 0 ;;
      *) die "unknown argument: $1" ;;
    esac
  done

  [ -n "$alias" ] || die "--alias needs a value"
  case "$alias" in *[!A-Za-z0-9._-]*) die "alias may only contain letters, digits, dot, underscore and dash" ;; esac
  case "$validity" in ''|*[!0-9]*) die "--validity needs a number of days" ;; esac

  # The key is generated here, on the machine that will keep the backup, and
  # never on a runner. A key that exists only inside CI is a key that is gone
  # when CI is.
  if [ -e "$ks_path" ] && [ "$force" != "true" ]; then
    die "$ks_path already exists. Pass --force to replace it, but only if you are certain the old key is backed up: apps signed with it will never update."
  fi

  mkdir -p "$(dirname "$ks_path")"
  chmod 700 "$(dirname "$ks_path")" 2>/dev/null || true
  mkdir -p "$(dirname "$env_file")"

  # prompt twice, never on the command line, so it stays out of shell history
  # and out of this process's arguments.
  local ks_pass key_pass
  printf 'Keystore password (min 6 chars): ' >&2
  IFS= read -r ks_pass
  printf 'Confirm: ' >&2
  local confirm
  IFS= read -r confirm
  [ "$ks_pass" = "$confirm" ] || die "passwords do not match"
  [ "${#ks_pass}" -ge 6 ] || die "use at least 6 characters"
  printf 'Key password (blank to reuse the keystore password): ' >&2
  IFS= read -r key_pass
  key_pass="${key_pass:-$ks_pass}"
  [ "$key_pass" = "$ks_pass" ] || {
    printf 'Confirm key password: ' >&2
    IFS= read -r confirm
    [ "$key_pass" = "$confirm" ] || die "passwords do not match"
  }

  [ -n "$dname" ] || dname="CN=$alias, OU=Android, O=fbt, C=US"

  printf 'generating %s\n' "$ks_path" >&2
  ( umask 077
    if command -v keytool >/dev/null 2>&1; then
      keytool -genkeypair -v \
        -keystore "$ks_path" -storetype PKCS12 \
        -alias "$alias" -keyalg RSA -keysize 4096 \
        -validity "$validity" -dname "$dname" \
        -storepass "$ks_pass" -keypass "$key_pass" >/dev/null
    elif command -v openssl >/dev/null 2>&1; then
      # PKCS#12 rather than JKS: keytool and AGP both read it, so a key made
      # on a machine with openssl but no JDK still builds on a runner that has
      # the opposite. Explicit PBEs keep openssl from emitting RC2, which Java
      # 17 refuses to read.
      local tmp
      tmp="$(mktemp -d)"
      openssl req -x509 -newkey rsa:4096 -nodes -days "$validity" \
        -subj "/$dname" -keyout "$tmp/k.pem" -out "$tmp/c.pem" >/dev/null 2>&1
      openssl pkcs12 -export \
        -inkey "$tmp/k.pem" -in "$tmp/c.pem" -name "$alias" \
        -passout "pass:$ks_pass" \
        -keypbe AES-256-CBC -certpbe AES-256-CBC -macalg sha256 \
        -out "$ks_path"
      rm -rf "$tmp"
    else
      die "neither keytool nor openssl is available. Install a JDK or run 'fbt keygen' on a machine that has one."
    fi
  ) || die "key generation failed"

  chmod 600 "$ks_path"

  local fp
  fp="$(key_fingerprint "$ks_path" "$ks_pass" "$alias")"
  [ -n "$fp" ] || die "could not read the generated key back. The keystore is at $ks_path; inspect it before trusting it."

  ( umask 077
    {
      printf 'RELEASE_KEYSTORE_PATH=%s\n' "$ks_path"
      printf 'RELEASE_KEYSTORE_PASSWORD=%s\n' "$ks_pass"
      printf 'RELEASE_KEY_ALIAS=%s\n' "$alias"
      printf 'RELEASE_KEY_PASSWORD=%s\n' "$key_pass"
    } > "$env_file"
  )
  chmod 600 "$env_file"

  info "keystore:  $ks_path"
  info "alias:     $alias"
  info "validity:  $validity days"
  info "SHA-256:   $fp"
  cat >&2 <<EOF

  Copy $ks_path somewhere offline now, then run 'fbt key push' to store it as
  a secret on the tool repo. If the key is lost, apps signed with it can never
  be updated again, only uninstalled and reinstalled under a new id.
EOF
}

cmd_key_push() {
  local tool_repo="$TOOL_REPO"
  while [ $# -gt 0 ]; do
    case "$1" in
      --tool) tool_repo="${2:-}"; shift 2 ;;
      -h|--help) usage_build; exit 0 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [ -n "$tool_repo" ] || die "no tool repo configured. Pass --tool <owner>/<repo> or set TOOL_REPO in ~/.config/fbt/config."
  require gh
  gh auth status >/dev/null 2>&1 || die "gh is not authenticated. Run 'gh auth login'."

  resolve_signing

  local fp
  fp="$(key_fingerprint "$KS_PATH" "$KS_PASS" "$KEY_ALIAS")"
  [ -n "$fp" ] || die "could not read the keystore with the recorded password and alias. Fix $(signing_env_file) and try again."

  # Secrets cannot be read back, so this is the moment to be sure. Once it is
  # overwritten and the local copy is gone, the key is unrecoverable.
  local have
  have="$(signing_secrets_present "$tool_repo" || true)"
  if printf '%s\n' "$have" | grep -qxF RELEASE_KEYSTORE_B64; then
    printf 'fbt: %s already has a release keystore.\n' "$tool_repo" >&2
    printf 'fbt: local key SHA-256: %s\n' "$fp" >&2
    printf 'fbt: replacing it re-points every future release build at the new key.\n' >&2
    printf 'fbt: if any app was already published with the old key, it can never update again.\n' >&2
    printf 'fbt: type "replace" to continue: ' >&2
    local reply=""
    IFS= read -r reply || die "aborted"
    [ "$reply" = "replace" ] || die "aborted"
  fi

  info "uploading key to $tool_repo"
  # Values go in on stdin, never as an argument, so they stay out of the process
  # table and out of any shell trace.
  base64 -w 0 "$KS_PATH" | gh secret set RELEASE_KEYSTORE_B64 --repo "$tool_repo"
  printf '%s' "$KS_PASS"   | gh secret set RELEASE_KEYSTORE_PASSWORD --repo "$tool_repo"
  printf '%s' "$KEY_ALIAS" | gh secret set RELEASE_KEY_ALIAS --repo "$tool_repo"
  printf '%s' "$KEY_PASS"  | gh secret set RELEASE_KEY_PASSWORD --repo "$tool_repo"

  info "stored 4 signing secrets"
  info "alias   $KEY_ALIAS"
  info "SHA-256 $fp"
  cat >&2 <<'EOF'

  These live as encrypted Actions secrets on a public repository. They are never
  printed in logs and are not readable through the API, but every workflow that
  runs there can use them. Keep an offline copy of the keystore: the secret
  store is not a backup.
EOF
}

cmd_key() {
  local tool_repo="$TOOL_REPO"
  while [ $# -gt 0 ]; do
    case "$1" in
      --tool) tool_repo="${2:-}"; shift 2 ;;
      -h|--help) usage_build; exit 0 ;;
      *) die "unknown argument: $1" ;;
    esac
  done

  local env_file; env_file="$(signing_env_file)"
  s_keystore="" s_store_pass="" s_alias="" s_key_pass=""
  signing_read_env "$env_file"
  local ks="${FBT_KEYSTORE:-${s_keystore:-}}" alias="${FBT_KEY_ALIAS:-${s_alias:-}}"
  local pass="${FBT_KEYSTORE_PASSWORD:-${s_store_pass:-}}"

  printf 'local:\n'
  printf '  env file:   %s%s\n' "$env_file" "$([ -f "$env_file" ] || printf ' (missing)')"
  if [ -z "$ks" ]; then
    printf '  keystore:   not configured. Run "fbt keygen".\n'
  elif [ ! -f "$ks" ]; then
    printf '  keystore:   %s (missing)\n' "$ks"
  else
    printf '  keystore:   %s (%s, mode %s)\n' "$ks" "$(du -h "$ks" | cut -f1)" "$(stat -c '%a' "$ks")"
    printf '  alias:      %s\n' "${alias:-unset}"
    local fp=""
    [ -n "$pass" ] && fp="$(key_fingerprint "$ks" "$pass" "$alias")"
    printf '  SHA-256:    %s\n' "${fp:-unreadable (no password recorded, or the alias is wrong)}"
  fi

  printf 'tool repo:\n'
  printf '  repository: %s\n' "${tool_repo:-unset}"
  if [ -z "$tool_repo" ]; then
    return 0
  fi
  local have missing="" want
  have="$(signing_secrets_present "$tool_repo" || true)"
  [ -n "$have" ] || have=""
  for want in "${SIGNING_SECRETS[@]}"; do
    if printf '%s\n' "$have" | grep -qxF "$want"; then
      printf '  %s\n' "$want"
    else
      missing="$missing $want"
    fi
  done
  [ -z "$missing" ] || printf '  missing:%s\n' "$missing"
  return 0
}

cmd_build() {
  [ $# -ge 1 ] || { usage_build; exit 1; }

  local dir="$1"; shift
  local variant="debug"
  local signed="false"
  local tool_repo="$TOOL_REPO"

  local lang="android"
  local profile="release"
  local target=""
  local features=""
  local all_features="false"
  local no_default_features="false"
  local run_tests="false"
  local raw="false"
  local goos=""
  local goarch=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --tool)    tool_repo="${2:-}"; shift 2 ;;
      --variant) variant="${2:-}"; shift 2 ;;
      --release) variant="release"; signed="true"; shift ;;
      --sign)    signed="true"; shift ;;
      --no-sign) signed="false"; shift ;;
      --rust)    lang="rust"; shift ;;
      --go)      lang="go"; shift ;;
      --profile) profile="${2:-}"; shift 2 ;;
      --target)  target="${2:-}"; shift 2 ;;
      --goos)    goos="${2:-}"; shift 2 ;;
      --goarch)  goarch="${2:-}"; shift 2 ;;
      --features) features="${2:-}"; shift 2 ;;
      --all-features) all_features="true"; shift ;;
      --no-default-features) no_default_features="true"; shift ;;
      --tests)   run_tests="true"; shift ;;
      --raw)     raw="true"; shift ;;
      -h|--help) usage_build; exit 0 ;;
      *) die "unknown argument: $1" ;;
    esac
  done

  [ -n "$tool_repo" ] || die "no tool repo configured. Pass --tool <owner>/<repo>, set TOOL_REPO in ~/.config/fbt/config, or export FBT_TOOL_REPO."

  # Checked before anything is uploaded, so a flag combination that cannot work
  # does not cost a gist and a delete.
  [ "$signed" = "false" ] || [ "$lang" = "android" ] \
    || die "--release and --sign are Android-only. Rust builds use --profile release, which is already the default."

  # Allowlisted rather than shape-checked: a typo here costs a gist and a
  # runner minute to discover, and the values the go tool accepts are a small,
  # stable set.
  case "$goos" in
    ''|aix|android|darwin|dragonfly|freebsd|illumos|ios|js|linux|netbsd|openbsd|plan9|solaris|wasip1|windows|zos) ;;
    *) die "unknown --goos: $goos" ;;
  esac
  case "$goarch" in
    ''|386|amd64|arm|arm64|loong64|mips|mipsle|mips64|mips64le|ppc64|ppc64le|riscv64|s390x|wasm) ;;
    *) die "unknown --goarch: $goarch" ;;
  esac

  [ -d "$dir" ] || die "not a directory: $dir"
  dir="$(cd "$dir" && pwd)"
  local name; name="$(basename "$dir")"

  require gh
  require tar
  require git

  gh auth status >/dev/null 2>&1 || die "gh is not authenticated. Run 'gh auth login'."

  # A missing secret should not cost a gist upload and two runner minutes to
  # discover. Needs gh, so it happens after the auth check.
  [ "$signed" = "true" ] && require_signing_secrets "$tool_repo"

  mkdir -p "$DOWNLOAD_DIR"

  # Deliberately not local: the EXIT traps installed below fire after this
  # function returns, and a local would already be out of scope by then.
  work="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$work'" EXIT

  local tarball="$work/src.tar.gz"
  info "packaging $name"
  package_project "$dir" "$tarball" || die "packaging failed"

  # Gists only accept text. Base64 is the transport encoding; the build
  # workflow decodes it back to a tarball before extracting.
  local b64="$work/src.tar.gz.b64"
  base64 -w 0 "$tarball" > "$b64"
  rm -f "$tarball"

  local size
  size="$(du -h "$b64" | cut -f1)"
  info "encoded source is $size"

  info "uploading source to secret gist"
  # No --public flag: gists are secret by default and only visible to this
  # account unless explicitly published.
  # gh writes its progress lines to stderr and only the URL to stdout, so
  # capture stdout alone and let stderr pass through for the user.
  local gist_url
  if ! gist_url="$(gh gist create "$b64")"; then
    die "gist upload failed"
  fi
  local gist_id
  # Gist IDs are long hex strings. Matching on the trailing path segment is
  # safer than matching "/gist/" because the canonical URL is
  # https://gist.github.com/<user>/<id>, where the host itself contains "gist".
  gist_id="$(printf '%s' "$gist_url" | grep -oE '[a-f0-9]{20,}$' | head -1)"
  [ -n "$gist_id" ] || die "could not determine gist id from: $gist_url"
  info "gist $gist_id"

  # Best-effort cleanup on any early exit.
  cleanup() { gh gist delete "$gist_id" --yes >/dev/null 2>&1 || true; }
  trap 'cleanup; rm -rf "$work"' EXIT

  local workflow="android.yml"
  local event_type="build"

  # Captured at dispatch time. The window has to be tight: a loose one lets a
  # run from a previous invocation match, and fbt would then wait on a build
  # for a gist that local cleanup already deleted.
  local after_epoch
  after_epoch="$(date -u +%s)"

  if [ "$lang" = "rust" ]; then
    workflow="rust.yml"
    event_type="rust"
    info "dispatching rust build: profile=$profile target=${target:-host} features=${features:-none} tests=$run_tests raw=$raw"
    gh api "repos/$tool_repo/dispatches" \
      -f "event_type=$event_type" \
      -F "client_payload[project]=$name" \
      -f "client_payload[gist_id]=$gist_id" \
      -f "client_payload[profile]=$profile" \
      -f "client_payload[target]=$target" \
      -f "client_payload[features]=$features" \
      -f "client_payload[all_features]=$all_features" \
      -f "client_payload[no_default_features]=$no_default_features" \
      -f "client_payload[run_tests]=$run_tests" \
      -f "client_payload[raw]=$raw" >/dev/null \
      || die "dispatch failed"
  elif [ "$lang" = "go" ]; then
    workflow="go.yml"
    event_type="go"
    info "dispatching go build: goos=${goos:-host} goarch=${goarch:-host} tests=$run_tests"
    gh api "repos/$tool_repo/dispatches" \
      -f "event_type=$event_type" \
      -F "client_payload[project]=$name" \
      -f "client_payload[gist_id]=$gist_id" \
      -f "client_payload[goos]=$goos" \
      -f "client_payload[goarch]=$goarch" \
      -f "client_payload[run_tests]=$run_tests" >/dev/null \
      || die "dispatch failed"
  else
    info "dispatching android build: variant=$variant signed=$signed"
    gh api "repos/$tool_repo/dispatches" \
      -f "event_type=$event_type" \
      -F "client_payload[project]=$name" \
      -F "client_payload[variant]=$variant" \
      -f "client_payload[signed]=$signed" \
      -f "client_payload[gist_id]=$gist_id" >/dev/null \
      || die "dispatch failed"
  fi

  info "waiting for run to start"
  local run_id=""
  for _ in $(seq 1 45); do
    sleep 2
    run_id="$(gh run list --repo "$tool_repo" --workflow "$workflow" \
      --event repository_dispatch --limit 5 --json databaseId,createdAt \
      --jq "[.[] | select((.createdAt | fromdate) > $after_epoch)][0].databaseId // empty" \
      2>/dev/null || true)"
    [ -n "$run_id" ] && break
  done
  [ -n "$run_id" ] || die "no new run appeared within 90s. Check: gh run list --repo $tool_repo --workflow $workflow"

  info "run $run_id"
  if ! gh run watch "$run_id" --repo "$tool_repo" --exit-status; then
    die "build failed. Logs: gh run view $run_id --repo $tool_repo --log-failed"
  fi

  local artifact
  artifact="$(gh api "repos/$tool_repo/actions/runs/$run_id/artifacts" \
    --jq '.artifacts[0].name' 2>/dev/null || true)"
  [ -n "$artifact" ] || die "no artifact on this run"

  info "downloading $artifact"
  gh run download "$run_id" --repo "$tool_repo" --name "$artifact" \
    --dir "$work/out" >/dev/null

  local dest
  if [ "$lang" = "rust" ]; then
    # The workflow uploads a dist/ directory whose contents depend on the crate:
    # a tarball or .bin files for binaries, .rlib for a library.
    mapfile -t files < <(find "$work/out" -type f \
      \( -name '*.tar.gz' -o -name '*.bin' -o -name '*.rlib' \
         -o -name '*.so' -o -name '*.dylib' -o -name '*.dll' -o -name '*.a' \) | sort)
    [ ${#files[@]} -gt 0 ] || die "artifact contained no recognizable build output"
    local moved=()
    for f in "${files[@]}"; do
      dest="$DOWNLOAD_DIR/$(basename "$f")"
      mv "$f" "$dest"
      moved+=("$dest")
    done
    for d in "${moved[@]}"; do
      info "artifact: $d ($(du -h "$d" | cut -f1))"
    done
    dest="${moved[0]}"
  elif [ "$lang" = "go" ]; then
    # The workflow uploads dist/ holding the single binary the module root
    # produced, named after the last element of the module path.
    mapfile -t files < <(find "$work/out" -type f | sort)
    [ ${#files[@]} -gt 0 ] || die "artifact contained no build output"
    local moved=()
    for f in "${files[@]}"; do
      dest="$DOWNLOAD_DIR/$(basename "$f")"
      mv "$f" "$dest"
      moved+=("$dest")
    done
    for d in "${moved[@]}"; do
      info "binary: $d ($(du -h "$d" | cut -f1))"
    done
    dest="${moved[0]}"
  else
    local apk; apk="$(find "$work/out" -name '*.apk' -type f | head -1)"
    [ -n "$apk" ] || die "artifact contained no APK"
    dest="$DOWNLOAD_DIR/${name}-${variant}.apk"
    mv "$apk" "$dest"
    info "APK: $dest ($(du -h "$dest" | cut -f1))"
  fi

  cleanup
  trap 'rm -rf "$work"' EXIT

  printf '%s\n' "$dest"
}

load_config

case "${1:-}" in
  build) shift; cmd_build "$@" ;;
  keygen) shift; cmd_keygen "$@" ;;
  key)
    shift
    case "${1:-}" in
      push) shift; cmd_key_push "$@" ;;
      "")   cmd_key ;;
      *) die "unknown key subcommand: $1. Try 'fbt key push'." ;;
    esac
    ;;
  ""|-h|--help|help) usage_build ;;
  *) die "unknown command: $1" ;;
esac